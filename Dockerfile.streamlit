FROM python:3.11-slim
WORKDIR /opt/supply-chain-monitor

# Install only Phase 5 deps (not all of Airflow)
COPY requirements-phase5.txt .
RUN pip install --no-cache-dir -r requirements-phase5.txt

COPY . .

EXPOSE 8501

ENTRYPOINT ["streamlit","run","dashboard/app.py","--server.port=8501","--server.address=0.0.0.0","--server.headless=true"]