NEO4J_URI=bolt://scm_neo4j:7687
NEO4J_USER="neo4j"
NEO4J_PASSWORD="supply_chain_secret"
NEO4J_DATABASE="neo4j"

# ── Phase 2 (Airflow) ──────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY="UDrhCvRtPdoO6G4cDwSCDb5ElqaYw_19u9sFbUa0DJg="

# ── Phase 2 (WeatherAPI) ───────────────────────────────────────────
# Free tier at https://www.weatherapi.com/ — sign up, copy your API key
WEATHERAPI_KEY="97f81debc21b440e8e960611262106"

AIRFLOW_UID = 50000
# ── Phase 2 (GDELT) ────────────────────────────────────────────────
# No API key required — GDELT Doc API is free and open
GDELT_TIMESPAN=LAST24H

# ── Phase 2 (PortWatch / MarineTraffic) ────────────────────────────
# Set PORTWATCH_MOCK=true to use mock port data (safe for dev/portfolio demo)
# Set to false and add MARINETRAFFIC_API_KEY to use real vessel data
PORTWATCH_MOCK=true
MARINETRAFFIC_API_KEY=


# NLP MODELS  (Phase 3)
# spaCy model name. Downloaded at Docker image build time (see Dockerfile).
# Do not change unless you swap the model.
SPACY_MODEL=en_core_web_md           # ← OPTIONAL

# Sentence-transformer model name. Prefetched at Docker build time.
EMBEDDING_MODEL=all-MiniLM-L6-v2        # ← OPTIONAL

# HuggingFace cache directory inside the container.
# Sentence-transformer downloads are stored here.
TRANSFORMERS_CACHE=/opt/airflow/.cache/huggingface   # ← OPTIONAL

# Set to 1 to suppress HuggingFace tokenizer parallelism warnings in Airflow logs.
TOKENIZERS_PARALLELISM=false             # ← OPTIONAL


# ─────────────────────────────────────────────────────────────────────────────
# PYTHON PATH  (all phases)
# ─────────────────────────────────────────────────────────────────────────────

# Must point to the root of the project inside the container.
# Matches the volume mount in docker-compose.yml: .:/opt/airflow/supply-chain-monitor
PYTHONPATH=/opt/airflow/supply-chain-monitor