# Neo4j — used from your machine (outside Docker)
NEO4J_URI="bolt://localhost:7687"

# Neo4j — used from inside Docker containers (Phase 2 Airflow DAGs)
NEO4J_URI_DOCKER="bolt://neo4j:7687"

NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="supply_chain_secret"

# App
APP_ENV="development"
LOG_LEVEL="INFO"

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_URL=" redis://redis:6379"

# ─────────────────────────────────────────────
# WEATHERAPI
# Sign up free at https://www.weatherapi.com
# Free tier: 1 million calls/month
# ─────────────────────────────────────────────
WEATHERAPI_KEY="97f81debc21b440e8e960611262106"

# ─────────────────────────────────────────────
# AIRFLOW
# ─────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN="sqlite:////opt/airflow/airflow.db"
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY="supply_chain_airflow_secret"
AIRFLOW_ADMIN_USERNAME="admin"
AIRFLOW_ADMIN_PASSWORD="airflow_admin_secret"

# ─────────────────────────────────────────────
# RAW EVENT STORE (SQLite)
# ─────────────────────────────────────────────
RAW_EVENT_DB="data/raw_events.db"

# ─────────────────────────────────────────────
# PHASE 2 PIPELINE SETTINGS
# ─────────────────────────────────────────────
USGS_MIN_MAGNITUDE=5.0
MIN_CONGESTION_INDEX=0.3